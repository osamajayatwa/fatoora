rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUser() {
      return isSignedIn() && exists(userPath());
    }

    function user() {
      return get(userPath()).data;
    }

    function profileCompany(data) {
      return data.keys().hasAny(['companyId'])
        ? data.companyId
        : 'default_company';
    }

    function hasApprovedStatus(data) {
      return (
          data.keys().hasAny(['approvalStatus'])
          && data.approvalStatus == 'approved'
        )
        || (
          !data.keys().hasAny(['approvalStatus'])
          && data.role == 'admin'
        );
    }

    function isApprovedCompanyUser(companyId) {
      return hasUser()
        && profileCompany(user()) == companyId
        && user().active == true
        && hasApprovedStatus(user())
        && user().role in ['admin', 'sales_rep'];
    }

    function isAdmin(companyId) {
      return isApprovedCompanyUser(companyId) && user().role == 'admin';
    }

    function ownsCreatedDocument(data) {
      return data.keys().hasAny(['createdByUid'])
        && data.createdByUid == request.auth.uid;
    }

    function ownsSalesRepDocument(data) {
      return data.keys().hasAny(['salesRepId'])
        && data.salesRepId == request.auth.uid;
    }

    function canReadCreatedDocument(companyId, data) {
      return isApprovedCompanyUser(companyId)
        && (isAdmin(companyId) || ownsCreatedDocument(data));
    }

    function canReadSalesRepDocument(companyId, data) {
      return isApprovedCompanyUser(companyId)
        && (isAdmin(companyId) || ownsSalesRepDocument(data));
    }

    function canReadCustomerTransaction(companyId, data) {
      let customerPath =
        /databases/$(database)/documents/companies/$(companyId)/customers/$(data.customerId);
      return isApprovedCompanyUser(companyId)
        && (
          isAdmin(companyId)
          || ownsSalesRepDocument(data)
          || (
            data.keys().hasAny(['customerId'])
            && data.customerId is string
            && exists(customerPath)
            && get(customerPath).data.createdByUid == request.auth.uid
          )
        );
    }

    function canReadCashMovement(companyId, data) {
      return isApprovedCompanyUser(companyId)
        && (
          isAdmin(companyId)
          || (
            data.keys().hasAll(['cashAccount', 'salesRepId'])
            && data.cashAccount == 'rep_cash'
            && data.salesRepId == request.auth.uid
          )
        );
    }

    function canReadExpense(companyId, data) {
      return isApprovedCompanyUser(companyId)
        && (
          isAdmin(companyId)
          || (
            data.keys().hasAny(['paidByUid'])
            && data.paidByUid == request.auth.uid
          )
          || ownsSalesRepDocument(data)
        );
    }

    function settingsPath(companyId) {
      return /databases/$(database)/documents/companies/$(companyId)/settings/app;
    }

    function permissionAllows(companyId, field) {
      let path = settingsPath(companyId);
      return user().role == 'admin'
        || (
          user().role == 'sales_rep'
          && (
            !exists(path)
            || !get(path).data.keys().hasAny(['permissionSettings'])
            || !get(path).data.permissionSettings.keys().hasAny([field])
            || get(path).data.permissionSettings[field] == true
          )
        );
    }

    function configuredPrefix(companyId, prefix, field, fallback) {
      let path = settingsPath(companyId);
      return prefix is string
        && prefix.matches('^[A-Z0-9]{1,10}$')
        && (
          (
            exists(path)
            && get(path).data.keys().hasAny(['documentSettings'])
            && get(path).data.documentSettings.keys().hasAny([field])
            && prefix == get(path).data.documentSettings[field]
          )
          || (!exists(path) && prefix == fallback)
        );
    }

    function configuredNumber(companyId, number, field, fallback) {
      let path = settingsPath(companyId);
      return number is string
        && number.matches('^[A-Z0-9]{1,10}-[0-9]{4}-[0-9]{6}$')
        && (
          (
            exists(path)
            && get(path).data.keys().hasAny(['documentSettings'])
            && get(path).data.documentSettings.keys().hasAny([field])
            && number.matches(
              '^' + get(path).data.documentSettings[field]
              + '-[0-9]{4}-[0-9]{6}$'
            )
          )
          || (
            !exists(path)
            && number.matches('^' + fallback + '-[0-9]{4}-[0-9]{6}$')
          )
        );
    }

    function validPendingUserCreate(userId) {
      let data = request.resource.data;
      return isSignedIn()
        && request.auth.uid == userId
        && request.auth.token.email != null
        && data.keys().hasOnly([
          'uid', 'name', 'email', 'phone', 'photoUrl', 'role', 'active',
          'approvalStatus', 'companyId', 'createdAt', 'updatedAt'
        ])
        && data.uid == userId
        && data.email == request.auth.token.email
        && data.name is string
        && data.name.size() >= 2
        && data.name != 'undefined'
        && data.role == 'pending_sales_rep'
        && data.active == false
        && data.approvalStatus == 'pending'
        && data.companyId == 'default_company'
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validSafeSelfProfileUpdate(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isSignedIn()
        && request.auth.uid == userId
        && isApprovedCompanyUser(profileCompany(resource.data))
        && changed.hasOnly(['name', 'phone', 'photoUrl', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name != 'undefined'
        && request.resource.data.phone is string
        && request.resource.data.photoUrl is string
        && request.resource.data.updatedAt == request.time;
    }

    function validAdminUserUpdate(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isAdmin('default_company')
        && request.auth.uid != userId
        && profileCompany(resource.data) == 'default_company'
        && profileCompany(request.resource.data) == 'default_company'
        && changed.hasOnly([
          'name', 'phone', 'photoUrl', 'role', 'active', 'approvalStatus',
          'approvedAt', 'approvedByUid', 'rejectedAt', 'rejectedByUid',
          'updatedAt'
        ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.uid == userId
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.role in [
          'admin', 'sales_rep', 'pending_sales_rep'
        ]
        && request.resource.data.approvalStatus in [
          'approved', 'pending', 'rejected'
        ]
        && request.resource.data.updatedAt == request.time;
    }

    function validPreferencesWrite(userId, preferenceId) {
      let data = request.resource.data;
      return isSignedIn()
        && request.auth.uid == userId
        && preferenceId == 'app'
        && data.keys().hasOnly([
          'language', 'themeMode', 'defaultInvoiceNote',
          'defaultReceiptNote', 'updatedAt'
        ])
        && data.language in ['ar', 'en']
        && data.themeMode in ['system', 'light', 'dark']
        && data.defaultInvoiceNote is string
        && data.defaultReceiptNote is string
        && data.updatedAt == request.time;
    }

    function validAppSettings(companyId, settingsId) {
      let data = request.resource.data;
      return isAdmin(companyId)
        && settingsId == 'app'
        && data.keys().hasOnly([
          'companySettings', 'documentSettings', 'inventorySettings',
          'pdfSettings', 'permissionSettings', 'jofotaraStatusSettings',
          'schemaVersion', 'updatedAt', 'updatedByUid', 'updatedByName'
        ])
        && data.companySettings is map
        && data.companySettings.keys().hasOnly([
          'name', 'country', 'email', 'website', 'phone', 'address',
          'logoEnabled'
        ])
        && data.companySettings.name is string
        && data.companySettings.name.size() > 0
        && data.companySettings.country is string
        && data.companySettings.country.size() > 0
        && data.companySettings.email is string
        && data.companySettings.website is string
        && data.companySettings.phone is string
        && data.companySettings.address is string
        && data.companySettings.logoEnabled is bool
        && data.documentSettings is map
        && data.documentSettings.keys().hasOnly([
          'invoicePrefix', 'receiptPrefix', 'quotationPrefix',
          'salesReturnPrefix', 'defaultDueDays', 'defaultTaxPercent',
          'allowDiscount', 'allowSalesRepPriceEdit'
        ])
        && data.documentSettings.invoicePrefix.matches('^[A-Z0-9]{1,10}$')
        && data.documentSettings.receiptPrefix.matches('^[A-Z0-9]{1,10}$')
        && data.documentSettings.quotationPrefix.matches('^[A-Z0-9]{1,10}$')
        && data.documentSettings.salesReturnPrefix.matches('^[A-Z0-9]{1,10}$')
        && data.documentSettings.defaultDueDays is number
        && data.documentSettings.defaultDueDays >= 0
        && data.documentSettings.defaultDueDays <= 3650
        && data.documentSettings.defaultTaxPercent is number
        && data.documentSettings.defaultTaxPercent >= 0
        && data.documentSettings.defaultTaxPercent <= 100
        && data.documentSettings.allowDiscount is bool
        && data.documentSettings.allowSalesRepPriceEdit is bool
        && data.inventorySettings is map
        && data.inventorySettings.keys().hasOnly([
          'defaultWarehouseId', 'allowNegativeStock',
          'lowStockAlertsEnabled', 'defaultMinStock', 'trackStockByDefault'
        ])
        && data.inventorySettings.defaultWarehouseId is string
        && data.inventorySettings.defaultWarehouseId.size() > 0
        && data.inventorySettings.allowNegativeStock is bool
        && data.inventorySettings.lowStockAlertsEnabled is bool
        && data.inventorySettings.defaultMinStock is number
        && data.inventorySettings.defaultMinStock >= 0
        && data.inventorySettings.trackStockByDefault is bool
        && data.pdfSettings is map
        && data.pdfSettings.keys().hasOnly([
          'showLogo', 'showCompanyInfo', 'pdfLanguageMode',
          'invoiceFooterText', 'quotationTerms', 'receiptFooterText',
          'statementFooterText', 'defaultNotes'
        ])
        && data.pdfSettings.showLogo is bool
        && data.pdfSettings.showCompanyInfo is bool
        && data.pdfSettings.pdfLanguageMode in ['app_language', 'ar', 'en']
        && data.pdfSettings.invoiceFooterText is string
        && data.pdfSettings.quotationTerms is string
        && data.pdfSettings.receiptFooterText is string
        && data.pdfSettings.statementFooterText is string
        && data.pdfSettings.defaultNotes is string
        && data.permissionSettings is map
        && data.permissionSettings.keys().hasOnly([
          'allowSalesRepCreateCustomers', 'allowSalesRepCreateReceipts',
          'allowSalesRepCreateReturns', 'allowSalesRepCreateQuotations',
          'allowSalesRepPriceEdit', 'allowSalesRepDiscount'
        ])
        && data.permissionSettings.allowSalesRepCreateCustomers is bool
        && data.permissionSettings.allowSalesRepCreateReceipts is bool
        && data.permissionSettings.allowSalesRepCreateReturns is bool
        && data.permissionSettings.allowSalesRepCreateQuotations is bool
        && data.permissionSettings.allowSalesRepPriceEdit is bool
        && data.permissionSettings.allowSalesRepDiscount is bool
        && data.jofotaraStatusSettings is map
        && data.jofotaraStatusSettings.keys().hasOnly(['enabled', 'status'])
        && data.jofotaraStatusSettings.enabled == false
        && data.jofotaraStatusSettings.status in [
          'disabled', 'not_configured'
        ]
        && data.schemaVersion is number
        && data.schemaVersion >= 1
        && data.updatedAt == request.time
        && data.updatedByUid == request.auth.uid
        && data.updatedByName is string
        && data.updatedByName.size() > 0;
    }

    function customerAllowed(companyId, customerId) {
      let path =
        /databases/$(database)/documents/companies/$(companyId)/customers/$(customerId);
      let customer = get(path);
      return customerId is string
        && customerId.size() > 0
        && exists(path)
        && customer.data.companyId == companyId
        && customer.data.active == true
        && (
          user().role == 'admin'
          || customer.data.createdByUid == request.auth.uid
        );
    }

    function validCreator(companyId, data) {
      return isApprovedCompanyUser(companyId)
        && data.companyId == companyId
        && data.createdByUid == request.auth.uid
        && data.createdByName is string
        && data.createdByName.size() > 0
        && data.createdByName != 'undefined'
        && data.createdByRole == user().role;
    }

    function validCatalogUpdate() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return isAdmin('default_company')
        && changed.hasOnly([
          'name', 'code', 'description', 'unit', 'price', 'taxRate',
          'active', 'minStock', 'trackStock', 'costPrice', 'barcode',
          'category', 'warehouseId', 'deleted', 'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.code is string
        && data.code.size() > 0
        && data.unit is string
        && data.unit.size() > 0
        && data.price is number
        && data.price >= 0
        && data.taxRate is number
        && data.taxRate >= 0
        && data.taxRate <= 100
        && data.active is bool
        && data.minStock is number
        && data.minStock >= 0
        && data.trackStock is bool
        && data.costPrice is number
        && data.costPrice >= 0
        && data.deleted is bool
        && data.updatedAt == request.time;
    }

    function validInvoiceStockSource(companyId, data) {
      return (
          user().role == 'admin'
          && data.stockSourceType == 'companyWarehouse'
          && data.stockSourceSalesRepId == ''
        )
        || (
          user().role == 'sales_rep'
          && data.salesRepId == request.auth.uid
          && data.stockSourceType == 'salesRep'
          && data.stockSourceSalesRepId == request.auth.uid
        );
    }

    function validInvoiceDraftData(companyId, invoiceId, data) {
      return data.id == invoiceId
        && data.companyId == companyId
        && configuredNumber(
          companyId, data.invoiceNumber, 'invoicePrefix', 'INV'
        )
        && data.invoiceStatus == 'draft'
        && data.salesRepId.size() > 0
        && data.salesRepName.size() > 0
        && data.salesRepName != 'undefined'
        && customerAllowed(companyId, data.customerId)
        && data.items is list
        && data.items.size() > 0
        && data.items.size() <= 100
        && data.subtotal >= 0
        && data.totalDiscount >= 0
        && data.totalDiscount <= data.subtotal
        && data.totalTax >= 0
        && data.grandTotal > 0
        && data.paidAmount >= 0
        && data.paidAmount <= data.grandTotal
        && data.remainingAmount == data.grandTotal - data.paidAmount
        && data.returnStatus == 'none'
        && data.returnedTotal == 0
        && data.returnedSubtotal == 0
        && data.returnedDiscount == 0
        && data.returnedTax == 0
        && data.returnedReceivableAmount == 0
        && data.customerCreditAmount == 0
        && data.cashRefundAmount == 0
        && data.returnInvoiceIds.size() == 0
        && data.latestReturnAt == null
        && data.receiptIds.size() == 0
        && data.lastReceiptId == ''
        && data.isLocked == false
        && data.financialPosted == false
        && data.financialPostedAt == null
        && data.financialPostedByUid == ''
        && data.financialPostedByName == ''
        && data.customerTransactionIds.size() == 0
        && data.cashMovementIds.size() == 0
        && data.inventoryPosted == false
        && data.inventoryPostedAt == null
        && data.inventoryPostedByUid == ''
        && data.inventoryPostedByName == ''
        && data.inventoryMovementIds.size() == 0
        && validInvoiceStockSource(companyId, data)
        && data.searchKeywords is list;
    }

    function validInvoiceDraftCreate(companyId, invoiceId) {
      let data = request.resource.data;
      return validCreator(companyId, data)
        && validInvoiceDraftData(companyId, invoiceId, data)
        && (isAdmin(companyId) || data.salesRepId == request.auth.uid)
        && (isAdmin(companyId) || data.totalDiscount == 0 || permissionAllows(companyId, 'allowSalesRepDiscount'))
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validInvoiceDraftUpdate(companyId) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return canReadSalesRepDocument(companyId, resource.data)
        && resource.data.invoiceStatus == 'draft'
        && resource.data.financialPosted == false
        && resource.data.inventoryPosted == false
        && data.invoiceStatus == 'draft'
        && data.financialPosted == false
        && data.inventoryPosted == false
        && changed.hasOnly([
          'invoiceType', 'paymentType', 'paymentStatus',
          'hasReceivedPayment', 'invoiceDate', 'dueDate', 'customerId',
          'customerSnapshot', 'items', 'subtotal', 'totalDiscount', 'totalTax',
          'grandTotal', 'paidAmount', 'remainingAmount', 'notes',
          'paymentMethod', 'searchKeywords', 'customerNameLower',
          'itemNamesLower', 'invoiceNumberLower', 'dateString', 'government',
          'updatedAt'
        ])
        && customerAllowed(companyId, data.customerId)
        && data.items is list
        && data.items.size() > 0
        && data.items.size() <= 100
        && data.subtotal >= 0
        && data.totalDiscount >= 0
        && data.totalDiscount <= data.subtotal
        && data.totalTax >= 0
        && data.grandTotal > 0
        && data.paidAmount >= 0
        && data.paidAmount <= data.grandTotal
        && data.remainingAmount == data.grandTotal - data.paidAmount
        && (isAdmin(companyId) || data.totalDiscount == 0 || permissionAllows(companyId, 'allowSalesRepDiscount'))
        && data.updatedAt == request.time;
    }

    function sourceInvoiceAllowed(companyId, data) {
      let path =
        /databases/$(database)/documents/companies/$(companyId)/invoices/$(data.originalInvoiceId);
      return data.originalInvoiceId is string
        && data.originalInvoiceId.size() > 0
        && exists(path)
        && get(path).data.companyId == companyId
        && get(path).data.invoiceStatus in ['confirmed', 'accepted']
        && data.originalInvoiceNumber == get(path).data.invoiceNumber
        && data.customerId == get(path).data.customerId
        && data.salesRepId == get(path).data.salesRepId
        && (
          isAdmin(companyId)
          || get(path).data.salesRepId == request.auth.uid
        );
    }

    function validReturnDraftData(companyId, returnId, data) {
      return data.keys().hasOnly([
          'id', 'companyId', 'returnNumber', 'returnInvoiceId',
          'originalInvoiceId', 'originalInvoiceNumber', 'originalInvoiceDate',
          'customerId', 'customerSnapshot', 'items', 'subtotal',
          'totalDiscount', 'totalTax', 'grandTotal', 'receivableReduction',
          'customerCreditAmount', 'cashRefundAmount', 'refundType',
          'returnDate', 'reason', 'status', 'salesRepId', 'salesRepName',
          'createdByUid', 'createdByName', 'createdByRole', 'financialPosted',
          'inventoryPosted', 'financialPostedAt', 'inventoryPostedAt',
          'stockMovementIds', 'customerTransactionIds', 'cashMovementIds',
          'createdAt', 'updatedAt'
        ])
        && data.id == returnId
        && data.returnInvoiceId == returnId
        && data.companyId == companyId
        && configuredNumber(
          companyId, data.returnNumber, 'salesReturnPrefix', 'RET'
        )
        && sourceInvoiceAllowed(companyId, data)
        && data.originalInvoiceDate is timestamp
        && data.customerSnapshot is map
        && data.items is list
        && data.items.size() > 0
        && data.items.size() <= 100
        && data.subtotal is number
        && data.subtotal >= 0
        && data.totalDiscount is number
        && data.totalDiscount >= 0
        && data.totalTax is number
        && data.totalTax >= 0
        && data.grandTotal is number
        && data.grandTotal > 0
        && data.refundType in ['credit_customer_balance', 'cash_refund']
        && data.returnDate is timestamp
        && data.reason is string
        && data.reason.size() > 0
        && data.status == 'draft'
        && data.salesRepId is string
        && data.salesRepId.size() > 0
        && data.salesRepName is string
        && data.salesRepName.size() > 0
        && data.createdByUid is string
        && data.createdByName is string
        && data.createdByName.size() > 0
        && data.createdByName != 'undefined'
        && data.createdByRole is string
        && data.financialPosted == false
        && data.inventoryPosted == false
        && data.financialPostedAt == null
        && data.inventoryPostedAt == null
        && data.stockMovementIds.size() == 0
        && data.customerTransactionIds.size() == 0
        && data.cashMovementIds.size() == 0
        && data.receivableReduction == 0
        && data.customerCreditAmount == 0
        && data.cashRefundAmount == 0;
    }

    function validReturnDraftCreate(companyId, returnId) {
      let data = request.resource.data;
      return validCreator(companyId, data)
        && permissionAllows(companyId, 'allowSalesRepCreateReturns')
        && validReturnDraftData(companyId, returnId, data)
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validReturnDraftUpdate(companyId) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return canReadSalesRepDocument(companyId, resource.data)
        && resource.data.status == 'draft'
        && resource.data.financialPosted == false
        && resource.data.inventoryPosted == false
        && permissionAllows(companyId, 'allowSalesRepCreateReturns')
        && data.status == 'draft'
        && data.financialPosted == false
        && data.inventoryPosted == false
        && changed.hasOnly([
          'customerSnapshot', 'items', 'subtotal', 'totalDiscount', 'totalTax',
          'grandTotal', 'refundType', 'returnDate', 'reason', 'updatedAt'
        ])
        && data.items is list
        && data.items.size() > 0
        && data.items.size() <= 100
        && data.subtotal >= 0
        && data.totalDiscount >= 0
        && data.totalTax >= 0
        && data.grandTotal > 0
        && data.refundType in ['credit_customer_balance', 'cash_refund']
        && data.reason is string
        && data.reason.size() > 0
        && data.updatedAt == request.time;
    }

    function validQuotationData(companyId, quotationId, data) {
      return data.keys().hasOnly([
          'id', 'companyId', 'quotationNumber', 'quotationDate', 'validUntil',
          'customerId', 'customerSnapshot', 'items', 'subtotal',
          'totalDiscount', 'totalTax', 'grandTotal', 'notes', 'terms', 'status',
          'salesRepId', 'salesRepName', 'createdByUid', 'createdByName',
          'createdByRole', 'convertedInvoiceId', 'convertedInvoiceNumber',
          'createdAt', 'updatedAt', 'searchKeywords'
        ])
        && data.id == quotationId
        && data.companyId == companyId
        && configuredNumber(
          companyId, data.quotationNumber, 'quotationPrefix', 'QUO'
        )
        && data.quotationDate is timestamp
        && data.validUntil is timestamp
        && data.validUntil >= data.quotationDate
        && customerAllowed(companyId, data.customerId)
        && data.customerSnapshot is map
        && data.items is list
        && data.items.size() > 0
        && data.items.size() <= 100
        && data.subtotal is number
        && data.subtotal >= 0
        && data.totalDiscount is number
        && data.totalDiscount >= 0
        && data.totalDiscount <= data.subtotal
        && data.totalTax is number
        && data.totalTax >= 0
        && data.grandTotal is number
        && data.grandTotal > 0
        && data.notes is string
        && data.terms is string
        && data.status in [
          'draft', 'sent', 'accepted', 'rejected', 'expired', 'converted'
        ]
        && data.salesRepId is string
        && data.salesRepId.size() > 0
        && data.salesRepName is string
        && data.salesRepName.size() > 0
        && data.salesRepName != 'undefined'
        && data.createdByUid is string
        && data.createdByName is string
        && data.createdByName.size() > 0
        && data.createdByName != 'undefined'
        && data.createdByRole is string
        && data.convertedInvoiceId is string
        && data.convertedInvoiceNumber is string
        && data.searchKeywords is list;
    }

    function validQuotationCreate(companyId, quotationId) {
      let data = request.resource.data;
      return validCreator(companyId, data)
        && permissionAllows(companyId, 'allowSalesRepCreateQuotations')
        && (isAdmin(companyId) || data.totalDiscount == 0 || permissionAllows(companyId, 'allowSalesRepDiscount'))
        && validQuotationData(companyId, quotationId, data)
        && data.status == 'draft'
        && data.convertedInvoiceId == ''
        && data.convertedInvoiceNumber == ''
        && (isAdmin(companyId) || data.salesRepId == request.auth.uid)
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validQuotationDraftUpdate(companyId) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return canReadSalesRepDocument(companyId, resource.data)
        && resource.data.status == 'draft'
        && data.status == 'draft'
        && data.convertedInvoiceId == ''
        && data.convertedInvoiceNumber == ''
        && changed.hasOnly([
          'quotationDate', 'validUntil', 'customerSnapshot', 'items',
          'subtotal', 'totalDiscount', 'totalTax', 'grandTotal', 'notes',
          'terms', 'searchKeywords', 'updatedAt'
        ])
        && data.items is list
        && data.items.size() > 0
        && data.items.size() <= 100
        && data.subtotal >= 0
        && data.totalDiscount >= 0
        && data.totalDiscount <= data.subtotal
        && data.totalTax >= 0
        && data.grandTotal > 0
        && (isAdmin(companyId) || data.totalDiscount == 0 || permissionAllows(companyId, 'allowSalesRepDiscount'))
        && data.updatedAt == request.time;
    }

    function validQuotationStatusUpdate(companyId) {
      return canReadSalesRepDocument(companyId, resource.data)
        && resource.data.status != 'converted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt'
        ])
        && request.resource.data.status in [
          'sent', 'accepted', 'rejected', 'expired'
        ]
        && request.resource.data.updatedAt == request.time;
    }

    function validQuotationConversion(companyId) {
      return request.resource.data.status == 'converted'
        && request.resource.data.convertedInvoiceId is string
        && request.resource.data.convertedInvoiceId.size() > 0
        && configuredNumber(
          companyId,
          request.resource.data.convertedInvoiceNumber,
          'invoicePrefix',
          'INV'
        )
        && canReadSalesRepDocument(companyId, resource.data)
        && resource.data.status in ['sent', 'accepted']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'convertedInvoiceId', 'convertedInvoiceNumber', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.convertedInvoiceId != resource.data.id;
    }

    function validExpenseRejection(companyId) {
      let data = request.resource.data;
      return isAdmin(companyId)
        && resource.data.status == 'pending'
        && data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reimbursementStatus', 'rejectedByUid', 'rejectedByName',
          'rejectedAt', 'rejectionReason', 'updatedAt'
        ])
        && data.status == 'rejected'
        && data.reimbursementStatus == 'none'
        && data.rejectedByUid == request.auth.uid
        && data.rejectedByName is string
        && data.rejectedByName.size() > 0
        && data.rejectedAt == request.time
        && data.rejectionReason is string
        && data.rejectionReason.size() > 0
        && data.updatedAt == request.time;
    }

    function validTransferData(companyId, transferId, data) {
      let repPath = /databases/$(database)/documents/users/$(data.salesRepId);
      return isAdmin(companyId)
        && data.keys().hasOnly([
          'id', 'companyId', 'transferNumber', 'year', 'type', 'status',
          'salesRepId', 'salesRepNameSnapshot', 'lines', 'totalQuantity',
          'notes', 'createdByUid', 'createdByName', 'createdAt', 'updatedAt',
          'confirmedByUid', 'confirmedByName', 'confirmedAt',
          'cancelledByUid', 'cancelledAt', 'effectsVersion'
        ])
        && data.id == transferId
        && data.companyId == companyId
        && data.transferNumber.matches('^TRN-[0-9]{4}-[0-9]{6}$')
        && data.year is number
        && data.type in ['warehouseToRep', 'repToWarehouse']
        && data.status in ['draft', 'cancelled']
        && data.salesRepId is string
        && data.salesRepId.size() > 0
        && exists(repPath)
        && get(repPath).data.role == 'sales_rep'
        && get(repPath).data.active == true
        && hasApprovedStatus(get(repPath).data)
        && profileCompany(get(repPath).data) == companyId
        && data.salesRepNameSnapshot is string
        && data.salesRepNameSnapshot.size() > 0
        && data.lines is list
        && data.lines.size() > 0
        && data.lines.size() <= 100
        && data.totalQuantity is number
        && data.totalQuantity > 0
        && data.notes is string
        && data.createdByUid is string
        && data.createdByName is string
        && data.createdByName.size() > 0
        && data.updatedAt == request.time
        && data.effectsVersion == 1
        && data.confirmedByUid == ''
        && data.confirmedByName == ''
        && data.confirmedAt == null;
    }

    function validTransferCreate(companyId, transferId) {
      let data = request.resource.data;
      return validTransferData(companyId, transferId, data)
        && data.status == 'draft'
        && data.createdByUid == request.auth.uid
        && data.createdAt == request.time
        && data.cancelledByUid == ''
        && data.cancelledAt == null;
    }

    function transferIdentityPreserved() {
      return request.resource.data.id == resource.data.id
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.transferNumber == resource.data.transferNumber
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdByName == resource.data.createdByName
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validTransferUpdate(companyId, transferId) {
      let data = request.resource.data;
      return resource.data.status == 'draft'
        && transferIdentityPreserved()
        && validTransferData(companyId, transferId, data)
        && (
          (
            data.status == 'draft'
            && data.cancelledByUid == ''
            && data.cancelledAt == null
          )
          || (
            data.status == 'cancelled'
            && data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'cancelledByUid', 'cancelledAt', 'updatedAt'
            ])
            && data.cancelledByUid == request.auth.uid
            && data.cancelledAt == request.time
          )
        );
    }

    function validCounterWrite(companyId, counterId) {
      let data = request.resource.data;
      return isApprovedCompanyUser(companyId)
        && counterId.matches(
          '^(invoices|sales_returns|quotations|inventory_transfers)_[0-9]{4}$'
        )
        && data.keys().hasOnly([
          'id', 'companyId', 'year', 'lastNumber', 'prefix', 'updatedAt'
        ])
        && data.id == counterId
        && data.companyId == companyId
        && data.year is number
        && data.year >= 2020
        && data.year <= 2100
        && data.lastNumber is number
        && data.lastNumber > 0
        && data.updatedAt == request.time
        && (
          (
            counterId.matches('^invoices_[0-9]{4}$')
            && configuredPrefix(
              companyId, data.prefix, 'invoicePrefix', 'INV'
            )
          )
          || (
            counterId.matches('^sales_returns_[0-9]{4}$')
            && permissionAllows(companyId, 'allowSalesRepCreateReturns')
            && configuredPrefix(
              companyId, data.prefix, 'salesReturnPrefix', 'RET'
            )
          )
          || (
            counterId.matches('^quotations_[0-9]{4}$')
            && permissionAllows(companyId, 'allowSalesRepCreateQuotations')
            && configuredPrefix(
              companyId, data.prefix, 'quotationPrefix', 'QUO'
            )
          )
          || (
            counterId.matches('^inventory_transfers_[0-9]{4}$')
            && isAdmin(companyId)
            && data.prefix == 'TRN'
          )
        );
    }

    match /users/{userId} {
      allow get: if isSignedIn()
        && (request.auth.uid == userId || isAdmin('default_company'));
      allow list: if isAdmin('default_company');
      allow create: if validPendingUserCreate(userId);
      allow update: if validSafeSelfProfileUpdate(userId)
        || validAdminUserUpdate(userId);
      allow delete: if false;

      match /preferences/{preferenceId} {
        allow get: if isSignedIn() && request.auth.uid == userId;
        allow list: if false;
        allow create, update: if validPreferencesWrite(userId, preferenceId);
        allow delete: if false;
      }
    }

    match /items/{itemId} {
      allow read: if isApprovedCompanyUser('default_company');
      allow create, delete: if false;
      allow update: if validCatalogUpdate();
    }

    match /companies/{companyId}/customers/{customerId} {
      allow get: if isApprovedCompanyUser(companyId)
        && (
          !exists(
            /databases/$(database)/documents/companies/$(companyId)/customers/$(customerId)
          )
          || canReadCreatedDocument(companyId, resource.data)
        );
      allow list: if canReadCreatedDocument(companyId, resource.data);
      allow write: if false;
    }

    match /companies/{companyId}/customer_phone_reservations/{reservationId} {
      allow read, write: if false;
    }

    match /companies/{companyId}/invoices/{invoiceId} {
      allow get: if isApprovedCompanyUser(companyId)
        && (
          !exists(
            /databases/$(database)/documents/companies/$(companyId)/invoices/$(invoiceId)
          )
          || canReadSalesRepDocument(companyId, resource.data)
        );
      allow list: if canReadSalesRepDocument(companyId, resource.data);
      allow create: if validInvoiceDraftCreate(companyId, invoiceId);
      allow update: if validInvoiceDraftUpdate(companyId);
      allow delete: if canReadSalesRepDocument(companyId, resource.data)
        && resource.data.invoiceStatus == 'draft'
        && resource.data.financialPosted == false
        && resource.data.inventoryPosted == false;
    }

    match /companies/{companyId}/customer_transactions/{transactionId} {
      allow get: if isApprovedCompanyUser(companyId)
        && (
          !exists(
            /databases/$(database)/documents/companies/$(companyId)/customer_transactions/$(transactionId)
          )
          || canReadCustomerTransaction(companyId, resource.data)
        );
      allow list: if canReadCustomerTransaction(companyId, resource.data);
      allow write: if false;
    }

    match /companies/{companyId}/receipts/{receiptId} {
      allow get: if isApprovedCompanyUser(companyId)
        && (
          !exists(
            /databases/$(database)/documents/companies/$(companyId)/receipts/$(receiptId)
          )
          || canReadSalesRepDocument(companyId, resource.data)
        );
      allow list: if canReadSalesRepDocument(companyId, resource.data);
      allow write: if false;
    }

    match /companies/{companyId}/sales_returns/{returnId} {
      allow get: if isApprovedCompanyUser(companyId)
        && (
          !exists(
            /databases/$(database)/documents/companies/$(companyId)/sales_returns/$(returnId)
          )
          || canReadSalesRepDocument(companyId, resource.data)
        );
      allow list: if canReadSalesRepDocument(companyId, resource.data);
      allow create: if validReturnDraftCreate(companyId, returnId);
      allow update: if validReturnDraftUpdate(companyId);
      allow delete: if false;
    }

    match /companies/{companyId}/quotations/{quotationId} {
      allow get: if isApprovedCompanyUser(companyId)
        && (
          !exists(
            /databases/$(database)/documents/companies/$(companyId)/quotations/$(quotationId)
          )
          || canReadSalesRepDocument(companyId, resource.data)
        );
      allow list: if canReadSalesRepDocument(companyId, resource.data);
      allow create: if validQuotationCreate(companyId, quotationId);
      allow update: if (
          resource.data.status == 'draft'
          && request.resource.data.status == 'draft'
          && validQuotationDraftUpdate(companyId)
        )
        || (
          request.resource.data.status == 'converted'
          && validQuotationConversion(companyId)
        )
        || (
          request.resource.data.status in [
            'sent', 'accepted', 'rejected', 'expired'
          ]
          && validQuotationStatusUpdate(companyId)
        );
      allow delete: if false;
    }

    match /companies/{companyId}/expenses/{expenseId} {
      allow get: if isApprovedCompanyUser(companyId)
        && (
          !exists(
            /databases/$(database)/documents/companies/$(companyId)/expenses/$(expenseId)
          )
          || canReadExpense(companyId, resource.data)
        );
      allow list: if canReadExpense(companyId, resource.data);
      allow create, delete: if false;
      allow update: if validExpenseRejection(companyId);
    }

    match /companies/{companyId}/cash_movements/{movementId} {
      allow get: if isApprovedCompanyUser(companyId)
        && (
          !exists(
            /databases/$(database)/documents/companies/$(companyId)/cash_movements/$(movementId)
          )
          || canReadCashMovement(companyId, resource.data)
        );
      allow list: if canReadCashMovement(companyId, resource.data);
      allow write: if false;
    }

    match /companies/{companyId}/cash_balances/{accountId} {
      allow read: if isApprovedCompanyUser(companyId)
        && (
          isAdmin(companyId)
          || (
            resource.data.cashAccount == 'rep_cash'
            && resource.data.salesRepId == request.auth.uid
          )
        );
      allow write: if false;
    }

    match /companies/{companyId}/settlements/{settlementId} {
      allow read: if isApprovedCompanyUser(companyId)
        && (isAdmin(companyId) || resource.data.salesRepId == request.auth.uid);
      allow write: if false;
    }

    match /companies/{companyId}/stock_movements/{movementId} {
      allow get: if isApprovedCompanyUser(companyId)
        && (
          !exists(
            /databases/$(database)/documents/companies/$(companyId)/stock_movements/$(movementId)
          )
          || canReadCreatedDocument(companyId, resource.data)
        );
      allow list: if canReadCreatedDocument(companyId, resource.data);
      allow write: if false;
    }

    match /companies/{companyId}/inventory_transfers/{transferId} {
      allow get, list: if canReadSalesRepDocument(companyId, resource.data);
      allow create: if validTransferCreate(companyId, transferId);
      allow update: if validTransferUpdate(companyId, transferId);
      allow delete: if isAdmin(companyId) && resource.data.status == 'draft';
    }

    match /companies/{companyId}/rep_inventory_balances/{balanceId} {
      allow get: if exists(
          /databases/$(database)/documents/companies/$(companyId)/rep_inventory_balances/$(balanceId)
        )
        && canReadSalesRepDocument(companyId, resource.data);
      allow list: if canReadSalesRepDocument(companyId, resource.data);
      allow write: if false;
    }

    match /companies/{companyId}/rep_inventory_movements/{movementId} {
      allow get: if exists(
          /databases/$(database)/documents/companies/$(companyId)/rep_inventory_movements/$(movementId)
        )
        && canReadSalesRepDocument(companyId, resource.data);
      allow list: if canReadSalesRepDocument(companyId, resource.data);
      allow write: if false;
    }

    match /companies/{companyId}/counters/{counterId} {
      allow read: if isApprovedCompanyUser(companyId);
      allow create: if validCounterWrite(companyId, counterId)
        && request.resource.data.lastNumber == 1;
      allow update: if validCounterWrite(companyId, counterId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.year == resource.data.year
        && resource.data.lastNumber is number
        && request.resource.data.lastNumber == resource.data.lastNumber + 1;
      allow delete: if false;
    }

    match /companies/{companyId}/settings/{settingsId} {
      allow get: if settingsId == 'app' && isApprovedCompanyUser(companyId);
      allow list: if false;
      allow create, update: if validAppSettings(companyId, settingsId);
      allow delete: if false;
    }

    match /companies/{companyId}/audit_events/{eventId} {
      allow read: if isAdmin(companyId);
      allow write: if false;

      match /details/{detailId} {
        allow read: if isAdmin(companyId);
        allow write: if false;
      }
    }

    match /companies/{companyId}/maintenance_locks/{lockId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
