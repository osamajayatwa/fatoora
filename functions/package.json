{
  "name": "fatoora-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test:integrity": "npm run build && node scripts/run_integrity_tests.js",
    "audit:integrity": "node scripts/integrity_reconciliation.js",
    "audit:jihad:readonly": "node scripts/audit_jihad_readonly.js",
    "test:jihad-readonly": "node --test test/audit_jihad_readonly.test.js test/integrity_reconciliation.test.js",
    "test:rules": "node --test test/firestore.rules.test.js",
    "test:trusted": "npm run build && node --test test/trusted_transactions.test.js test/confirm_sales_return_auth.test.js test/phase1_permissions.test.js",
    "test:maintenance": "node --test test/invoice_sales_rep_maintenance.test.js test/invoice_list_fields_maintenance.test.js test/cash_reconciliation.test.js",
    "test:search": "node --test test/search_keywords.test.js",
    "test:search:emulator": "npm run build && node --test test/search_inventory.test.js",
    "test:receipt-cancellation": "npm run build && node --test test/cancel_receipt.test.js",
    "test:customer-assignment": "npm run build && node --test test/customer_assignment.test.js",
    "backfill:customer-assignment": "npm run build && node scripts/backfill_customer_assignment.js",
    "test:performance": "npm run build && node --test test/performance_reporting.test.js",
    "test:audit": "npm run build && node --test test/audit.test.js",
    "test:financial-ledger": "npm run build && node --test test/financial_ledger.test.js",
    "audit:invoice-sales-rep": "node scripts/audit_invoice_sales_rep.js",
    "backfill:invoice-sales-rep": "node scripts/backfill_invoice_sales_rep.js",
    "audit:invoice-list-fields": "node scripts/backfill_invoice_list_fields.js",
    "backfill:invoice-list-fields": "node scripts/backfill_invoice_list_fields.js --apply",
    "backfill:item-search-fields": "node scripts/backfill_item_search_fields.js",
    "backfill:search-keywords": "node scripts/backfill_search_keywords.js",
    "backfill:dashboard-return-fields": "node scripts/backfill_dashboard_return_fields.js",
    "backfill:business-search-fields": "node scripts/backfill_business_search_fields.js",
    "reconcile:cash": "node scripts/reconcile_cash_balances.js",
    "rebuild:financial-ledger": "npm run build && node lib/maintenance/rebuild_financial_ledger.js",
    "migrate:financial-ledger-query-keys": "npm run build && node lib/maintenance/migrate_financial_ledger_query_keys.js",
    "rebuild:financial-ledger-account-activity": "npm run build && node lib/maintenance/rebuild_financial_ledger_account_activity.js"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase": "^12.15.0",
    "typescript": "^5.7.2"
  }
}
